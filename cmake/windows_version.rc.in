#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FIXHOP_VERSION_MAJOR@,@FIXHOP_VERSION_MINOR@,@FIXHOP_VERSION_PATCH@,0
 PRODUCTVERSION @FIXHOP_VERSION_MAJOR@,@FIXHOP_VERSION_MINOR@,@FIXHOP_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @FIXHOP_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments", "@FIXHOP_COMMENTS@\0"
            VALUE "FileDescription", "@FIXHOP_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "@FIXHOP_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "https://github.com/speedrun-16/fixhop\0"
            VALUE "OriginalFilename", "@FIXHOP_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "fixhop\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
